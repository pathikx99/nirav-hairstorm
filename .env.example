# =============================================================================
# Nirav Hairstorm — Environment Configuration
# =============================================================================

# Application Settings
APP_NAME="Nirav Hairstorm"
VERSION="1.0.0"
DEBUG=false

# Database Configuration (Default: Local Zero-Config SQLite, no Docker/Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./data/hairstorm.db
# To use external PostgreSQL instead, uncomment below:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=hairstorm
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hairstorm

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","https://your-frontend-domain.com"]

# Frontend Public API URL (Accessible by client browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
