# =============================================================================
# Nirav Hairstorm — Environment Configuration
# =============================================================================

# Application Settings
APP_NAME="Nirav Hairstorm"
VERSION="1.0.0"
DEBUG=false

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hairstorm
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hairstorm

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://your-frontend-domain.com"]

# Frontend Public API URL (Accessible by client browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
