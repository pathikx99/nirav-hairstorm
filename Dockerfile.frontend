FROM node:20-alpine AS base

# Step 1: Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Step 2: Build the Next.js application
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

ARG NEXT_PUBLIC_AVATAR_RENDERER=auto
ENV NEXT_PUBLIC_AVATAR_RENDERER=${NEXT_PUBLIC_AVATAR_RENDERER}

ARG NEXT_PUBLIC_ENABLE_P4_WEBGL=true
ENV NEXT_PUBLIC_ENABLE_P4_WEBGL=${NEXT_PUBLIC_ENABLE_P4_WEBGL}

ARG NEXT_PUBLIC_AVATAR_CDN_URL=
ENV NEXT_PUBLIC_AVATAR_CDN_URL=${NEXT_PUBLIC_AVATAR_CDN_URL}

RUN npm run build

# Step 3: Production runtime runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

USER nextjs

EXPOSE 3000

CMD ["npm", "run", "start"]
